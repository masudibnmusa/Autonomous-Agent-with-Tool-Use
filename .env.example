ANTHROPIC_API_KEY=your_key_here
MODEL_NAME=claude-sonnet-5-5

# Tavily (https://tavily.com). Swap the search tool for SerpAPI/Bing if you prefer
SEARCH_API_KEY=your_search_key_here

MAX_ITERATIONS=15
MAX_CONSECUTIVE_ERRORS=3
ALLOWED_TOOLS=web_search,web_browse,code_executor,api_caller,calculator,file_tool
ALLOWED_API_DOMAINS=api.github.com

SANDBOX_MODE=docker
SANDBOX_IMAGE=agent-sandbox
SANDBOX_TIMEOUT_SEC=10
SANDBOX_MEMORY_MB=256

REQUIRE_APPROVAL=true
USE_PLANNER=false